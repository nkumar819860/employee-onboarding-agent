<?xml version="1.0" encoding="UTF-8"?>
<mule xmlns:http="http://www.mulesoft.org/schema/mule/http"
      xmlns:ee="http://www.mulesoft.org/schema/mule/ee/core"
      xmlns:db="http://www.mulesoft.org/schema/mule/db"
      xmlns:file="http://www.mulesoft.org/schema/mule/file"
      xmlns:async="http://www.mulesoft.org/schema/mule/async"
      xmlns="http://www.mulesoft.org/schema/mule/core"
      xmlns:doc="http://www.mulesoft.org/schema/mule/documentation"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:schemaLocation="
        http://www.mulesoft.org/schema/mule/core http://www.mulesoft.org/schema/mule/core/current/mule.xsd
        http://www.mulesoft.org/schema/mule/http http://www.mulesoft.org/schema/mule/http/current/mule-http.xsd
        http://www.mulesoft.org/schema/mule/ee/core http://www.mulesoft.org/schema/mule/ee/core/current/mule-ee.xsd
        http://www.mulesoft.org/schema/mule/db http://www.mulesoft.org/schema/mule/db/current/mule-db.xsd
        http://www.mulesoft.org/schema/mule/file http://www.mulesoft.org/schema/mule/file/current/mule-file.xsd
        http://www.mulesoft.org/schema/mule/async http://www.mulesoft.org/schema/mule/async/current/mule-async.xsd">

    <!-- ========================================================================================= -->
    <!-- ENHANCED EMPLOYEE DETAILS SERVICE WITH MULTIPLE FALLBACK SCENARIOS -->
    <!-- ========================================================================================= -->
    
    <!-- Main Employee Details Retrieval Flow with Circuit Breaker Pattern -->
    <flow name="get-employee-details-enhanced" doc:id="enhanced-employee-details-flow">
        <logger level="INFO" doc:name="Start Enhanced Employee Details Retrieval"
                message="Starting enhanced employee details retrieval for employeeId: #[attributes.uriParams.employeeId]"/>
        
        <!-- Initialize fallback tracking variables -->
        <set-variable variableName="employeeId" value="#[attributes.uriParams.employeeId]" doc:name="Set Employee ID"/>
        <set-variable variableName="email" value="#[attributes.queryParams.email default '']" doc:name="Set Email"/>
        <set-variable variableName="fallbackAttempts" value="0" doc:name="Initialize Fallback Counter"/>
        <set-variable variableName="employeeDetails" value="{}" doc:name="Initialize Employee Details"/>
        <set-variable variableName="retrievalMethods" value="[]" doc:name="Initialize Retrieval Methods"/>
        <set-variable variableName="startTime" value="#[now()]" doc:name="Set Start Time"/>
        
        <!-- Step 1: Cache Check First (Primary Fallback) -->
        <logger level="DEBUG" message="Fallback 1: Checking cache for employee: #[vars.employeeId]" doc:name="Cache Check Log"/>
        <flow-ref name="check-employee-cache" doc:name="Check Cache"/>
        
        <choice doc:name="Cache Hit or Miss">
            <when expression="#[payload.found == true]">
                <logger level="INFO" message="Employee details found in cache for ID: #[vars.employeeId]"/>
                <set-variable variableName="retrievalMethods" value="#[vars.retrievalMethods ++ ['cache']]" doc:name="Add Cache to Methods"/>
                <ee:transform doc:name="Return Cached Data">
                    <ee:message>
                        <ee:set-payload><![CDATA[%dw 2.0
output application/json
---
{
    success: true,
    source: "cache",
    employeeId: vars.employeeId,
    data: payload.data,
    retrievalTime: now(),
    fallbacksUsed: 0,
    retrievalMethods: vars.retrievalMethods,
    performance: {
        totalTime: (now() - vars.startTime) as String,
        cacheHit: true
    }
}]]></ee:set-payload>
                    </ee:message>
                </ee:transform>
            </when>
            <otherwise>
                <!-- Step 2: Primary Database Retrieval -->
                <flow-ref name="primary-database-retrieval-with-fallbacks" doc:name="Primary Database with Fallbacks"/>
            </otherwise>
        </choice>
    </flow>

    <!-- Cache Check Flow (Simplified - no actual cache) -->
    <flow name="check-employee-cache" doc:id="cache-check-flow">
        <logger level="DEBUG" message="Cache check skipped - cache module not available" doc:name="Cache Skip Log"/>
        <ee:transform doc:name="Cache Miss Response">
            <ee:message>
                <ee:set-payload><![CDATA[%dw 2.0
output application/json
---
{
    found: false,
    source: "cache",
    note: "cache_module_not_available"
}]]></ee:set-payload>
            </ee:message>
        </ee:transform>
    </flow>

    <!-- Primary Database Retrieval with Comprehensive Fallbacks -->
    <flow name="primary-database-retrieval-with-fallbacks" doc:id="primary-db-with-fallbacks">
        <logger level="INFO" message="Fallback 2: Attempting primary database retrieval for employee: #[vars.employeeId]"/>
        
        <try doc:name="Try Primary Database">
            <db:select doc:name="Primary DB Query" config-ref="H2_Database_Config">
                <db:sql>
                    SELECT 
                        employee_id,
                        first_name,
                        last_name,
                        email,
                        phone,
                        department,
                        position,
                        start_date,
                        salary,
                        manager,
                        manager_email,
                        company_name,
                        status,
                        created_at,
                        updated_at
                    FROM employees 
                    WHERE employee_id = :employeeId OR email = :email
                    ORDER BY updated_at DESC
                    LIMIT 1
                </db:sql>
            <db:input-parameters><![CDATA[#[{
                employeeId: vars.employeeId,
                email: vars.email
            }]]]></db:input-parameters>
            </db:select>
            
            <choice doc:name="Primary DB Result Check">
                <when expression="#[sizeOf(payload) > 0]">
                    <set-variable variableName="retrievalMethods" value="#[vars.retrievalMethods ++ ['primary_database']]" doc:name="Add Primary DB to Methods"/>
                    <set-variable variableName="employeeDetails" value="#[payload[0]]" doc:name="Store Employee Details"/>
                    
                    <!-- Cache the result for future use -->
                    <async doc:name="Cache Employee Data Async">
                        <logger level="DEBUG" message="Employee data cached for future retrieval: #[vars.employeeId]"/>
                    </async>
                    
                    <ee:transform doc:name="Primary DB Success Response">
                        <ee:message>
                            <ee:set-payload><![CDATA[%dw 2.0
output application/json
---
{
    success: true,
    source: "primary_database",
    employeeId: vars.employeeId,
    data: vars.employeeDetails ++ {
        retrievalSource: "primary_database",
        dataFreshness: "real_time"
    },
    retrievalTime: now(),
    fallbacksUsed: 0,
    retrievalMethods: vars.retrievalMethods,
    performance: {
        totalTime: (now() - vars.startTime) as String,
        databaseQuery: "successful"
    }
}]]></ee:set-payload>
                        </ee:message>
                    </ee:transform>
                </when>
                <otherwise>
                    <!-- Employee not found in primary database, try fallbacks -->
                    <flow-ref name="secondary-database-retrieval" doc:name="Secondary Database Fallback"/>
                </otherwise>
            </choice>
            
            <error-handler>
                <on-error-continue type="ANY">
                    <logger level="WARN" message="Primary database retrieval failed: #[error.description]" doc:name="Primary DB Error Log"/>
                    <set-variable variableName="fallbackAttempts" value="#[vars.fallbackAttempts + 1]" doc:name="Increment Fallback Counter"/>
                    <flow-ref name="secondary-database-retrieval" doc:name="Secondary Database Fallback"/>
                </on-error-continue>
            </error-handler>
        </try>
    </flow>

    <!-- Secondary Database Retrieval (Backup Database) -->
    <flow name="secondary-database-retrieval" doc:id="secondary-db-retrieval">
        <logger level="INFO" message="Fallback 3: Attempting secondary/backup database retrieval for employee: #[vars.employeeId]"/>
        
        <try doc:name="Try Secondary Database">
            <!-- Simulate secondary database query with broader search criteria -->
            <db:select doc:name="Secondary DB Query" config-ref="H2_Database_Config">
                <db:sql>
                    SELECT 
                        employee_id,
                        first_name,
                        last_name,
                        email,
                        phone,
                        department,
                        position,
                        start_date,
                        salary,
                        manager,
                        manager_email,
                        company_name,
                        status,
                        created_at,
                        updated_at
                    FROM employees 
                    WHERE LOWER(email) LIKE LOWER(:emailPattern) 
                       OR LOWER(first_name || ' ' || last_name) LIKE LOWER(:namePattern)
                       OR employee_id LIKE :idPattern
                    ORDER BY updated_at DESC
                    LIMIT 3
                </db:sql>
            <db:input-parameters><![CDATA[#[{
                emailPattern: '%' ++ (vars.email default '') ++ '%',
                namePattern: '%' ++ vars.employeeId ++ '%',
                idPattern: '%' ++ vars.employeeId ++ '%'
            }]]]></db:input-parameters>
            </db:select>
            
            <choice doc:name="Secondary DB Result Check">
                <when expression="#[sizeOf(payload) > 0]">
                    <set-variable variableName="retrievalMethods" value="#[vars.retrievalMethods ++ ['secondary_database']]" doc:name="Add Secondary DB to Methods"/>
                    <set-variable variableName="employeeDetails" value="#[payload[0]]" doc:name="Store Employee Details"/>
                    <set-variable variableName="fallbackAttempts" value="#[vars.fallbackAttempts + 1]" doc:name="Increment Fallback Counter"/>
                    
                    <!-- Cache the result -->
                    <async doc:name="Cache Secondary DB Data">
                        <logger level="DEBUG" message="Secondary DB data cached: #[vars.employeeId]"/>
                    </async>
                    
                    <ee:transform doc:name="Secondary DB Success Response">
                        <ee:message>
                            <ee:set-payload><![CDATA[%dw 2.0
output application/json
---
{
    success: true,
    source: "secondary_database",
    employeeId: vars.employeeId,
    data: vars.employeeDetails ++ {
        retrievalSource: "secondary_database",
        dataFreshness: "backup_source",
        alternativeMatches: sizeOf(payload) - 1
    },
    retrievalTime: now(),
    fallbacksUsed: vars.fallbackAttempts,
    retrievalMethods: vars.retrievalMethods,
    performance: {
        totalTime: (now() - vars.startTime) as String,
        fallbackLevel: "secondary_database"
    }
}]]></ee:set-payload>
                        </ee:message>
                    </ee:transform>
                </when>
                <otherwise>
                    <!-- Secondary database also failed, try file-based fallback -->
                    <flow-ref name="file-based-employee-retrieval" doc:name="File-Based Fallback"/>
                </otherwise>
            </choice>
            
            <error-handler>
                <on-error-continue type="ANY">
                    <logger level="WARN" message="Secondary database retrieval failed: #[error.description]" doc:name="Secondary DB Error Log"/>
                    <set-variable variableName="fallbackAttempts" value="#[vars.fallbackAttempts + 1]" doc:name="Increment Fallback Counter"/>
                    <flow-ref name="file-based-employee-retrieval" doc:name="File-Based Fallback"/>
                </on-error-continue>
            </error-handler>
        </try>
    </flow>

    <!-- File-Based Employee Data Retrieval -->
    <flow name="file-based-employee-retrieval" doc:id="file-based-retrieval">
        <logger level="INFO" message="Fallback 4: Attempting file-based employee data retrieval for: #[vars.employeeId]"/>
        
        <try doc:name="Try File-Based Retrieval">
            <!-- Try to read from backup JSON file - simulate with mock data -->
            <set-payload value='{"employees":[]}' mimeType="application/json" doc:name="Mock File Data"/>
            
            <ee:transform doc:name="Parse and Search File Data">
                <ee:message>
                    <ee:set-payload><![CDATA[%dw 2.0
output application/json
var employees = payload.employees default []
var matchingEmployee = employees filter (
    $.employee_id == vars.employeeId or 
    $.email == vars.email or
    ($.first_name ++ " " ++ $.last_name) contains vars.employeeId
)[0]
---
if (matchingEmployee != null)
    {
        found: true,
        employee: matchingEmployee
    }
else
    {
        found: false,
        availableEmployees: sizeOf(employees)
    }]]></ee:set-payload>
                </ee:message>
            </ee:transform>
            
            <choice doc:name="File Data Found Check">
                <when expression="#[payload.found == true]">
                    <set-variable variableName="retrievalMethods" value="#[vars.retrievalMethods ++ ['file_backup']]" doc:name="Add File Backup to Methods"/>
                    <set-variable variableName="employeeDetails" value="#[payload.employee]" doc:name="Store Employee Details"/>
                    <set-variable variableName="fallbackAttempts" value="#[vars.fallbackAttempts + 1]" doc:name="Increment Fallback Counter"/>
                    
                    <!-- Cache the result -->
                    <async doc:name="Cache File Data">
                        <logger level="DEBUG" message="File backup data cached: #[vars.employeeId]"/>
                    </async>
                    
                    <ee:transform doc:name="File Backup Success Response">
                        <ee:message>
                            <ee:set-payload><![CDATA[%dw 2.0
output application/json
---
{
    success: true,
    source: "file_backup",
    employeeId: vars.employeeId,
    data: vars.employeeDetails ++ {
        retrievalSource: "file_backup",
        dataFreshness: "backup_file",
        warning: "Data retrieved from backup file - may not be current"
    },
    retrievalTime: now(),
    fallbacksUsed: vars.fallbackAttempts,
    retrievalMethods: vars.retrievalMethods,
    performance: {
        totalTime: (now() - vars.startTime) as String,
        fallbackLevel: "file_backup"
    }
}]]></ee:set-payload>
                        </ee:message>
                    </ee:transform>
                </when>
                <otherwise>
                    <!-- File backup also failed, try external API -->
                    <flow-ref name="external-api-employee-retrieval" doc:name="External API Fallback"/>
                </otherwise>
            </choice>
            
            <error-handler>
                <on-error-continue type="ANY">
                    <logger level="WARN" message="File-based retrieval failed: #[error.description]" doc:name="File Error Log"/>
                    <set-variable variableName="fallbackAttempts" value="#[vars.fallbackAttempts + 1]" doc:name="Increment Fallback Counter"/>
                    <flow-ref name="external-api-employee-retrieval" doc:name="External API Fallback"/>
                </on-error-continue>
            </error-handler>
        </try>
    </flow>

    <!-- External API Employee Data Retrieval -->
    <flow name="external-api-employee-retrieval" doc:id="external-api-retrieval">
        <logger level="INFO" message="Fallback 5: Attempting external API employee data retrieval for: #[vars.employeeId]"/>
        
        <try doc:name="Try External API">
            <!-- Simulate external HR system API call - mock for now -->
            <set-payload value='{}' mimeType="application/json" doc:name="Mock External API Response"/>
            
            <choice doc:name="External API Response Check">
                <when expression="#[payload != null and payload.employee_id != null]">
                    <set-variable variableName="retrievalMethods" value="#[vars.retrievalMethods ++ ['external_api']]" doc:name="Add External API to Methods"/>
                    <set-variable variableName="employeeDetails" value="#[payload]" doc:name="Store Employee Details"/>
                    <set-variable variableName="fallbackAttempts" value="#[vars.fallbackAttempts + 1]" doc:name="Increment Fallback Counter"/>
                    
                    <!-- Cache the result -->
                    <async doc:name="Cache External API Data">
                        <logger level="DEBUG" message="External API data cached: #[vars.employeeId]"/>
                    </async>
                    
                    <ee:transform doc:name="External API Success Response">
                        <ee:message>
                            <ee:set-payload><![CDATA[%dw 2.0
output application/json
---
{
    success: true,
    source: "external_api",
    employeeId: vars.employeeId,
    data: vars.employeeDetails ++ {
        retrievalSource: "external_hr_api",
        dataFreshness: "external_system",
        warning: "Data retrieved from external HR system"
    },
    retrievalTime: now(),
    fallbacksUsed: vars.fallbackAttempts,
    retrievalMethods: vars.retrievalMethods,
    performance: {
        totalTime: (now() - vars.startTime) as String,
        fallbackLevel: "external_api"
    }
}]]></ee:set-payload>
                        </ee:message>
                    </ee:transform>
                </when>
                <otherwise>
                    <!-- External API failed, try mock data generation -->
                    <flow-ref name="mock-employee-data-generation" doc:name="Mock Data Generation"/>
                </otherwise>
            </choice>
            
            <error-handler>
                <on-error-continue type="ANY">
                    <logger level="WARN" message="External API retrieval failed: #[error.description]" doc:name="External API Error Log"/>
                    <set-variable variableName="fallbackAttempts" value="#[vars.fallbackAttempts + 1]" doc:name="Increment Fallback Counter"/>
                    <flow-ref name="mock-employee-data-generation" doc:name="Mock Data Generation"/>
                </on-error-continue>
            </error-handler>
        </try>
    </flow>

    <!-- Mock Employee Data Generation (Final Fallback) -->
    <flow name="mock-employee-data-generation" doc:id="mock-data-generation">
        <logger level="WARN" message="Fallback 6 (Final): Generating mock employee data for: #[vars.employeeId]"/>
        
        <set-variable variableName="retrievalMethods" value="#[vars.retrievalMethods ++ ['mock_generation']]" doc:name="Add Mock Generation to Methods"/>
        <set-variable variableName="fallbackAttempts" value="#[vars.fallbackAttempts + 1]" doc:name="Increment Fallback Counter"/>
        
        <ee:transform doc:name="Generate Mock Employee Data">
            <ee:message>
                <ee:set-payload><![CDATA[%dw 2.0
output application/json
var mockEmployee = {
    employee_id: vars.employeeId,
    first_name: "Mock",
    last_name: "Employee",
    email: (vars.email default ("mock.employee." ++ vars.employeeId ++ "@company.com")),
    phone: "+1-555-0199",
    department: "Unknown Department",
    position: "Employee",
    start_date: "2024-01-01",
    salary: 50000,
    manager: "System Manager",
    manager_email: "system.manager@company.com",
    company_name: "Mock Company Inc.",
    status: "MOCK_DATA",
    created_at: now(),
    updated_at: now()
}
---
{
    success: true,
    source: "mock_generation",
    employeeId: vars.employeeId,
    data: mockEmployee ++ {
        retrievalSource: "mock_generation",
        dataFreshness: "generated",
        warning: "MOCK DATA - This is generated placeholder data as all retrieval methods failed"
    },
    retrievalTime: now(),
    fallbacksUsed: vars.fallbackAttempts,
    retrievalMethods: vars.retrievalMethods,
    performance: {
        totalTime: (now() - vars.startTime) as String,
        fallbackLevel: "mock_generation"
    },
    systemAlert: "All employee data sources failed - investigate system health"
}]]></ee:set-payload>
            </ee:message>
        </ee:transform>
        
        <!-- Log system alert for monitoring -->
        <logger level="ERROR" message="SYSTEM ALERT: All employee data retrieval methods failed for employeeId: #[vars.employeeId]. Fallback methods attempted: #[vars.retrievalMethods joinBy ', ']" doc:name="System Alert Log"/>
    </flow>

    <!-- ========================================================================================= -->
    <!-- CIRCUIT BREAKER AND HEALTH CHECK FLOWS -->
    <!-- ========================================================================================= -->
    
    <!-- Circuit Breaker Status Check -->
    <flow name="circuit-breaker-health-check" doc:id="circuit-breaker-health">
        <scheduler doc:name="Circuit Breaker Health Scheduler">
            <scheduling-strategy>
                <fixed-frequency frequency="30" startDelay="5" timeUnit="SECONDS"/>
            </scheduling-strategy>
        </scheduler>
        
        <logger level="DEBUG" message="Running circuit breaker health check"/>
        
        <parallel-foreach doc:name="Test All Retrieval Methods" collection='#[["database", "file", "cache", "external_api"]]'>
            <choice doc:name="Test Method">
                <when expression='#[payload == "database"]'>
                    <flow-ref name="test-database-connectivity" doc:name="Test Database"/>
                </when>
                <when expression='#[payload == "file"]'>
                    <flow-ref name="test-file-system-access" doc:name="Test File System"/>
                </when>
                <when expression='#[payload == "cache"]'>
                    <flow-ref name="test-cache-connectivity" doc:name="Test Cache"/>
                </when>
                <when expression='#[payload == "external_api"]'>
            <set-payload value='{"service": "external_api", "healthy": false, "details": "External API not configured"}' mimeType="application/json" doc:name="Mock External API Test"/>
                </when>
            </choice>
        </parallel-foreach>
        
        <ee:transform doc:name="Aggregate Health Status">
            <ee:message>
                <ee:set-payload><![CDATA[%dw 2.0
output application/json
var healthResults = payload map $.payload
var healthyServices = healthResults filter $.healthy == true
var unhealthyServices = healthResults filter $.healthy == false
---
{
    overallHealth: if (sizeOf(unhealthyServices) == 0) "HEALTHY" else if (sizeOf(healthyServices) > 0) "DEGRADED" else "UNHEALTHY",
    healthyServices: sizeOf(healthyServices),
    unhealthyServices: sizeOf(unhealthyServices),
    services: healthResults,
    timestamp: now(),
    recommendedAction: if (sizeOf(unhealthyServices) > 2) "INVESTIGATE_SYSTEM_HEALTH" else "MONITOR"
}]]></ee:set-payload>
            </ee:message>
        </ee:transform>
        
        <logger level="INFO" message="Circuit breaker health check completed - Overall health: #[payload.overallHealth]"/>
    </flow>

    <!-- Test Database Connectivity -->
    <flow name="test-database-connectivity" doc:id="test-db-connectivity">
        <try doc:name="Test Database Connection">
            <db:select config-ref="H2_Database_Config" doc:name="Test Query">
                <db:sql>SELECT COUNT(*) as count FROM employees LIMIT 1</db:sql>
            </db:select>
            
            <ee:transform doc:name="Database Healthy">
                <ee:message>
                    <ee:set-payload><![CDATA[%dw 2.0
output application/java
---
{
    service: "database",
    healthy: true,
    details: "Database connection successful"
}]]></ee:set-payload>
                </ee:message>
            </ee:transform>
            
            <error-handler>
                <on-error-continue type="ANY">
                    <ee:transform doc:name="Database Unhealthy">
                        <ee:message>
                            <ee:set-payload><![CDATA[%dw 2.0
output application/java
---
{
    service: "database",
    healthy: false,
    details: "Database connection failed: " ++ error.description
}]]></ee:set-payload>
                        </ee:message>
                    </ee:transform>
                </on-error-continue>
            </error-handler>
        </try>
    </flow>

    <!-- Test File System Access -->
    <flow name="test-file-system-access" doc:id="test-file-access">
        <try doc:name="Test File Access">
            <set-payload value='[]' mimeType="application/json" doc:name="Mock File List"/>
            
            <ee:transform doc:name="File System Healthy">
                <ee:message>
                    <ee:set-payload><![CDATA[%dw 2.0
output application/java
---
{
    service: "file_system",
    healthy: true,
    details: "File system accessible"
}]]></ee:set-payload>
                </ee:message>
            </ee:transform>
            
            <error-handler>
                <on-error-continue type="ANY">
                    <ee:transform doc:name="File System Unhealthy">
                        <ee:message>
                            <ee:set-payload><![CDATA[%dw 2.0
output application/java
---
{
    service: "file_system",
    healthy: false,
    details: "File system access failed: " ++ error.description
}]]></ee:set-payload>
                        </ee:message>
                    </ee:transform>
                </on-error-continue>
            </error-handler>
        </try>
    </flow>

    <!-- Test Cache Connectivity -->
    <flow name="test-cache-connectivity" doc:id="test-cache-connectivity">
        <try doc:name="Test Cache Access">
            <set-payload value='{"test": "health-check"}' mimeType="application/json" doc:name="Mock Cache Test"/>
            
            <ee:transform doc:name="Cache Healthy">
                <ee:message>
                    <ee:set-payload><![CDATA[%dw 2.0
output application/java
---
{
    service: "cache",
    healthy: true,
    details: "Cache system accessible"
}]]></ee:set-payload>
                </ee:message>
            </ee:transform>
            
            <error-handler>
                <on-error-continue type="ANY">
                    <ee:transform doc:name="Cache Unhealthy">
                        <ee:message>
                            <ee:set-payload><![CDATA[%dw 2.0
output application/java
---
{
    service: "cache",
    healthy: false,
    details: "Cache system failed: " ++ error.description
}]]></ee:set-payload>
                        </ee:message>
                    </ee:transform>
                </on-error-continue>
            </error-handler>
        </try>
    </flow>

    <!-- Test External API Connectivity (Mock Implementation) -->
    <flow name="test-external-api-connectivity" doc:id="test-external-api-connectivity">
        <try doc:name="Test External API Access">
            <set-payload value='{"status": "external_api_not_configured"}' mimeType="application/json" doc:name="Mock External API Test"/>
            
            <ee:transform doc:name="External API Status">
                <ee:message>
                    <ee:set-payload><![CDATA[%dw 2.0
output application/java
---
{
    service: "external_api",
    healthy: false,
    details: "External API not configured in this environment"
}]]></ee:set-payload>
                </ee:message>
            </ee:transform>
            
            <error-handler>
                <on-error-continue type="ANY">
                    <ee:transform doc:name="External API Unhealthy">
                        <ee:message>
                            <ee:set-payload><![CDATA[%dw 2.0
output application/java
---
{
    service: "external_api",
    healthy: false,
    details: "External API connection failed: " ++ error.description
}]]></ee:set-payload>
                        </ee:message>
                    </ee:transform>
                </on-error-continue>
            </error-handler>
        </try>
    </flow>

</mule>
