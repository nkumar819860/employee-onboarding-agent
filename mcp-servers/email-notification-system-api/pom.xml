<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" 
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 
                             http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.employee.onboarding</groupId>
        <artifactId>mcp-servers-parent</artifactId>
        <version>1.0.0</version>
    </parent>

    <artifactId>email-notification-system-api</artifactId>
    <packaging>mule-application</packaging>

    <name>Email Notification System API</name>
    <description>System API for sending email notifications during employee onboarding process including welcome emails, asset allocation notifications, and onboarding completion confirmations</description>

    <properties>
        <cloudhub.application.name>email-notification-system-api</cloudhub.application.name>
    </properties>

    <build>
        <plugins>
            <plugin>
                <groupId>org.mule.tools.maven</groupId>
                <artifactId>mule-maven-plugin</artifactId>
                <configuration>
                    <!-- Alternative deployment configuration using direct username/password -->
                    <deployment>
                        <uri>https://anypoint.mulesoft.com</uri>
                        <username>${username}</username>
                        <password>${password}</password>
                        <!-- Use encrypted password: mvn encrypt-password yourPassword -->
                    </deployment>
                    
                    <!-- CloudHub 2.0 deployment configuration (alternative) -->
                    <cloudhub2Deployment>
                        <applicationName>${cloudhub.application.name}</applicationName>
                        <target>${cloudhub.application.name}</target>
                        <properties>
                            <http.port>8081</http.port>
                            <https.port>8082</https.port>
                            <http.host>0.0.0.0</http.host>
                            <env>production</env>
                            <smtp.host>smtp.gmail.com</smtp.host>
                            <smtp.port>587</smtp.port>
                            <smtp.username>noreply@company.com</smtp.username>
                            <smtp.password>${secure::smtp.password}</smtp.password>
                            <smtp.tls.enabled>true</smtp.tls.enabled>
                            <smtp.auth.enabled>true</smtp.auth.enabled>
                            <email.from>noreply@company.com</email.from>
                            <email.reply.to>hr@company.com</email.reply.to>
                            <email.templates.path>src/main/resources/templates</email.templates.path>
                            <email.retry.attempts>3</email.retry.attempts>
                            <email.retry.delay>5000</email.retry.delay>
                            <monitoring.metrics.enabled>true</monitoring.metrics.enabled>
                        </properties>
                    </cloudhub2Deployment>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <dependencies>
        <!-- Mule HTTP Connector -->
        <dependency>
            <groupId>org.mule.connectors</groupId>
            <artifactId>mule-http-connector</artifactId>
            <classifier>mule-plugin</classifier>
        </dependency>

        <!-- Mule Email Connector -->
        <dependency>
            <groupId>org.mule.connectors</groupId>
            <artifactId>mule-email-connector</artifactId>
            <version>1.7.4</version>
            <classifier>mule-plugin</classifier>
        </dependency>

        <!-- APIKit Module -->
        <dependency>
            <groupId>org.mule.modules</groupId>
            <artifactId>mule-apikit-module</artifactId>
            <version>1.10.4</version>
            <classifier>mule-plugin</classifier>
        </dependency>

        <!-- Mule JSON Module -->
        <dependency>
            <groupId>org.mule.modules</groupId>
            <artifactId>mule-json-module</artifactId>
            <classifier>mule-plugin</classifier>
        </dependency>

        <!-- Mule Validation Module -->
        <dependency>
            <groupId>org.mule.modules</groupId>
            <artifactId>mule-validation-module</artifactId>
            <classifier>mule-plugin</classifier>
        </dependency>

        <!-- Mule Secure Configuration Property Module -->
        <dependency>
            <groupId>com.mulesoft.modules</groupId>
            <artifactId>mule-secure-configuration-property-module</artifactId>
            <classifier>mule-plugin</classifier>
        </dependency>

        <!-- Mule File Connector -->
        <dependency>
            <groupId>org.mule.connectors</groupId>
            <artifactId>mule-file-connector</artifactId>
            <version>1.5.1</version>
            <classifier>mule-plugin</classifier>
        </dependency>

        <!-- Jackson for JSON processing -->
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-core</artifactId>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>

        <!-- Apache Commons Pool -->
        <dependency>
            <groupId>org.apache.commons</groupId>
            <artifactId>commons-pool2</artifactId>
        </dependency>

        <!-- MUnit Testing Framework -->
        <dependency>
            <groupId>com.mulesoft.munit</groupId>
            <artifactId>munit-runner</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.mulesoft.munit</groupId>
            <artifactId>munit-tools</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

</project>
