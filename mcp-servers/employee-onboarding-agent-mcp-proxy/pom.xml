<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" 
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 
                             http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.employee.onboarding</groupId>
        <artifactId>mcp-servers-parent</artifactId>
        <version>1.0.0</version>
    </parent>

    <artifactId>employee-onboarding-agent-mcp-proxy</artifactId>
    <packaging>mule-application</packaging>

    <name>Employee Onboarding Agent MCP Proxy</name>
    <description>MCP (Model Context Protocol) proxy server for Employee Onboarding Agent interactions</description>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>

        <!-- Mule Runtime and Java versions -->
        <mule.version>4.9.6</mule.version>
        <mule.tools.version>4.2.0</mule.tools.version>
        <mule.maven.plugin.version>4.5.0</mule.maven.plugin.version>
        <maven.compiler.source>17</maven.compiler.source>
        <maven.compiler.target>17</maven.compiler.target>

        <!-- MCP Connector version -->
        <mcp.connector.version>1.3.0</mcp.connector.version>

        <!-- CloudHub deployment properties -->
        <cloudhub.application.name>employee-onboarding-mcp-proxy</cloudhub.application.name>
        <cloudhub.environment>Sandbox</cloudhub.environment>
        <cloudhub.region>us-east-2</cloudhub.region>
        <cloudhub.workers>1</cloudhub.workers>
        <cloudhub.worker.type>MICRO</cloudhub.worker.type>
        <cloudhub.runtime.version>4.9.6</cloudhub.runtime.version>
        <cloudhub.business.group>${project.groupId}</cloudhub.business.group>
        
        <!-- Application properties for CloudHub -->
        <app.runtime>4.9.6</app.runtime>
        <app.encoding>UTF-8</app.encoding>
        
        <!-- Security and monitoring -->
        <secure.properties>true</secure.properties>
        <anypoint.platform.analytics>true</anypoint.platform.analytics>
        <persistent.queues>false</persistent.queues>
        <persistent.object.store>false</persistent.object.store>
    </properties>

    <build>
        <plugins>
            <!-- Mule Maven Plugin for deployment -->
            <plugin>
                <groupId>org.mule.tools.maven</groupId>
                <artifactId>mule-maven-plugin</artifactId>
                <configuration>
                    <!-- Alternative deployment configuration using direct username/password -->
                    <!-- encryptProperties REMOVED - use secure properties instead -->
                    <deployment>
                        <uri>https://anypoint.mulesoft.com</uri>
                        <username>${username}</username>
                        <password>${password}</password>
                        <!-- Use encrypted password: mvn encrypt-password yourPassword -->
                    </deployment>
                    
                    <!-- CloudHub 2.0 deployment configuration (alternative) -->
                    <cloudhub2Deployment>
                        <uri>https://anypoint.mulesoft.com</uri>
                        <provider>MC</provider>
                        <environment>${cloudhub.environment}</environment>
                        <target>${cloudhub.application.name}</target>
                        <muleVersion>${cloudhub.runtime.version}</muleVersion>
                        <username>${anypoint.username}</username>
                        <password>${anypoint.password}</password>
                        <applicationName>${cloudhub.application.name}</applicationName>
                        <businessGroup>${cloudhub.business.group}</businessGroup>
                        <replicas>${cloudhub.workers}</replicas>
                        <vCores>0.1</vCores>
                        <properties>
                            <mule.env>${cloudhub.environment}</mule.env>
                            <mule.encoding>${app.encoding}</mule.encoding>
                            <anypoint.platform.analytics_enabled>${anypoint.platform.analytics}</anypoint.platform.analytics_enabled>
                            <secure.key>${secure.key}</secure.key>
                            <mcp.server.baseUrl>https://${cloudhub.application.name}.cloudhub.io</mcp.server.baseUrl>
                            <mcp.server.version>1.0.0</mcp.server.version>
                            <mcp.features.enabled>true</mcp.features.enabled>
                            <mcp.proxy.timeout>30000</mcp.proxy.timeout>
                            <http.port>8081</http.port>
                            <https.port>8082</https.port>
                            <http.host>0.0.0.0</http.host>
                        </properties>
                        <deploymentSettings>
                            <http>
                                <inbound>
                                    <lastMileSecurity>true</lastMileSecurity>
                                </inbound>
                            </http>
                        </deploymentSettings>
                    </cloudhub2Deployment>
                    <!-- ClassLoader configuration for shared libraries -->
                    <sharedLibraries>
                        <sharedLibrary>
                            <groupId>org.apache.commons</groupId>
                            <artifactId>commons-pool2</artifactId>
                        </sharedLibrary>
                    </sharedLibraries>
                </configuration>
            </plugin>

            <!-- Maven Compiler Plugin -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.11.0</version>
                <configuration>
                    <source>${maven.compiler.source}</source>
                    <target>${maven.compiler.target}</target>
                    <compilerArgs>
                        <arg>-parameters</arg>
                    </compilerArgs>
                </configuration>
            </plugin>

            <!-- Maven Clean Plugin -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-clean-plugin</artifactId>
                <version>3.3.2</version>
            </plugin>

            <!-- Maven Resources Plugin -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-resources-plugin</artifactId>
                <version>3.3.1</version>
                <configuration>
                    <encoding>UTF-8</encoding>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <dependencies>
        <!-- Jackson for JSON processing -->
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-core</artifactId>
            <version>2.15.3</version>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
            <version>2.15.3</version>
        </dependency>

        <!-- Mule Secure Configuration Property Module -->
        <dependency>
            <groupId>com.mulesoft.modules</groupId>
            <artifactId>mule-secure-configuration-property-module</artifactId>
            <version>1.2.5</version>
            <classifier>mule-plugin</classifier>
        </dependency>

        <!-- MUnit Testing Framework -->
        <dependency>
            <groupId>com.mulesoft.munit</groupId>
            <artifactId>munit-runner</artifactId>
            <version>3.2.0</version>
            <classifier>mule-plugin</classifier>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.mulesoft.munit</groupId>
            <artifactId>munit-tools</artifactId>
            <version>3.2.0</version>
            <classifier>mule-plugin</classifier>
            <scope>test</scope>
        </dependency>

        <!-- Apache Commons Pool for connection pooling -->
        <dependency>
            <groupId>org.apache.commons</groupId>
            <artifactId>commons-pool2</artifactId>
            <version>2.11.1</version>
        </dependency>

        <!-- WebSocket Connector -->
        <dependency>
            <groupId>org.mule.connectors</groupId>
            <artifactId>mule-wsc-connector</artifactId>
            <version>1.8.6</version>
            <classifier>mule-plugin</classifier>
        </dependency>

        <!-- Mule JSON Module -->
        <dependency>
            <groupId>org.mule.modules</groupId>
            <artifactId>mule-json-module</artifactId>
            <version>2.5.0</version>
            <classifier>mule-plugin</classifier>
        </dependency>

        <!-- Mule Validation Module -->
        <dependency>
            <groupId>org.mule.modules</groupId>
            <artifactId>mule-validation-module</artifactId>
            <version>2.0.4</version>
            <classifier>mule-plugin</classifier>
        </dependency>

        <!-- MCP Connector -->
        <dependency>
            <groupId>com.mulesoft.connectors</groupId>
            <artifactId>mule-mcp-connector</artifactId>
            <version>1.3.0</version>
            <classifier>mule-plugin</classifier>
        </dependency>

        <!-- Mule HTTP Connector -->
        <dependency>
            <groupId>org.mule.connectors</groupId>
            <artifactId>mule-http-connector</artifactId>
            <version>1.11.0</version>
            <classifier>mule-plugin</classifier>
        </dependency>

        <!-- Mule Sockets Connector -->
        <dependency>
            <groupId>org.mule.connectors</groupId>
            <artifactId>mule-sockets-connector</artifactId>
            <version>1.2.7</version>
            <classifier>mule-plugin</classifier>
        </dependency>
    </dependencies>

    <repositories>
        <repository>
            <id>anypoint-exchange-v3</id>
            <name>Anypoint Exchange</name>
            <url>https://maven.anypoint.mulesoft.com/api/v3/maven</url>
            <layout>default</layout>
        </repository>
        <repository>
            <id>mulesoft-releases</id>
            <name>MuleSoft Releases Repository</name>
            <url>https://repository.mulesoft.org/releases/</url>
            <layout>default</layout>
        </repository>
        <repository>
            <id>central</id>
            <name>Maven Central Repository</name>
            <url>https://repo1.maven.org/maven2</url>
            <layout>default</layout>
            <snapshots>
                <enabled>false</enabled>
            </snapshots>
        </repository>
        <repository>
            <id>mulesoft-public</id>
            <name>MuleSoft Public Repository</name>
            <url>https://repository.mulesoft.org/nexus/content/repositories/public/</url>
            <layout>default</layout>
            <snapshots>
                <enabled>true</enabled>
            </snapshots>
        </repository>
        <repository>
            <id>mcp-connector-repo</id>
            <name>MCP Connector Public Repository</name>
            <url>https://repository.mulesoft.org/nexus/content/repositories/releases/</url>
            <layout>default</layout>
            <releases>
                <enabled>true</enabled>
            </releases>
            <snapshots>
                <enabled>false</enabled>
            </snapshots>
        </repository>
    </repositories>

    <pluginRepositories>
        <pluginRepository>
            <id>mulesoft-releases</id>
            <name>MuleSoft Releases Repository</name>
            <layout>default</layout>
            <url>https://repository.mulesoft.org/releases/</url>
            <snapshots>
                <enabled>false</enabled>
            </snapshots>
        </pluginRepository>
    </pluginRepositories>

    <!-- Profile for different environments -->
    <profiles>
        <!-- Development Profile -->
        <profile>
            <id>dev</id>
            <activation>
                <activeByDefault>true</activeByDefault>
            </activation>
            <properties>
                <cloudhub.environment>Development</cloudhub.environment>
                <cloudhub.application.name>employee-onboarding-mcp-proxy-dev</cloudhub.application.name>
                <persistent.queues>false</persistent.queues>
                <anypoint.platform.analytics>false</anypoint.platform.analytics>
            </properties>
        </profile>

        <!-- Sandbox Profile -->
        <profile>
            <id>sandbox</id>
            <properties>
                <cloudhub.environment>Sandbox</cloudhub.environment>
                <cloudhub.application.name>employee-onboarding-mcp-proxy-sb</cloudhub.application.name>
                <persistent.queues>false</persistent.queues>
                <anypoint.platform.analytics>true</anypoint.platform.analytics>
            </properties>
        </profile>

        <!-- Production Profile -->
        <profile>
            <id>prod</id>
            <properties>
                <cloudhub.environment>Production</cloudhub.environment>
                <cloudhub.application.name>employee-onboarding-mcp-proxy</cloudhub.application.name>
                <cloudhub.workers>2</cloudhub.workers>
                <cloudhub.worker.type>SMALL</cloudhub.worker.type>
                <persistent.queues>true</persistent.queues>
                <persistent.object.store>true</persistent.object.store>
                <anypoint.platform.analytics>true</anypoint.platform.analytics>
                <secure.properties>true</secure.properties>
            </properties>
        </profile>
    </profiles>

</project>
