<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" 
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 
                             http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.employee.onboarding</groupId>
        <artifactId>mcp-servers-parent</artifactId>
        <version>1.0.0</version>
    </parent>
    <groupId>47562e5d-bf49-440a-a0f5-a9cea0a89aa9</groupId>

    <artifactId>employee-onboarding-agent-broker</artifactId>
    <packaging>mule-application</packaging>

    <name>Employee Onboarding Agent Broker</name>
    <description>Process API that orchestrates employee onboarding workflow by coordinating between system APIs and providing intelligent agent-based automation</description>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>

        <!-- Mule Runtime and Java versions -->
        <mule.version>4.9.6</mule.version>
        <mule.tools.version>4.2.0</mule.tools.version>
        <mule.maven.plugin.version>4.5.0</mule.maven.plugin.version>
        <maven.compiler.source>17</maven.compiler.source>
        <maven.compiler.target>17</maven.compiler.target>

        <!-- MCP Connector version -->
        <mcp.connector.version>1.3.1</mcp.connector.version>

        <!-- CloudHub deployment properties -->
        <cloudhub.application.name>employee-onboarding-agent-broker</cloudhub.application.name>
        <cloudhub.environment>Sandbox</cloudhub.environment>
        <cloudhub.region>us-east-1</cloudhub.region>
        <cloudhub.workers>1</cloudhub.workers>
        <cloudhub.worker.type>MICRO</cloudhub.worker.type>
        <cloudhub.runtime.version>4.9.6</cloudhub.runtime.version>
        <cloudhub.business.group>${project.groupId}</cloudhub.business.group>
        
        <!-- Application properties for CloudHub -->
        <app.runtime>4.9.6</app.runtime>
        <app.encoding>UTF-8</app.encoding>
        
        <!-- Security and monitoring -->
        <secure.properties>true</secure.properties>
        <anypoint.platform.analytics>true</anypoint.platform.analytics>
        <persistent.queues>false</persistent.queues>
        <persistent.object.store>false</persistent.object.store>
		<connectedApp.clientId>aec0b3117f7d4d4e8433a7d3d23bc80e</connectedApp.clientId>
		<connectedApp.clientSecret>9bc9D86a77b343b98a148C0313239aDA</connectedApp.clientSecret>
    </properties>
<distributionManagement>
    <repository>
        <id>anypoint-exchange-v3</id>
        <name>Exchange Private Repository</name>
        <url>https://maven.anypoint.mulesoft.com/api/v3/organizations/${project.groupId}/maven</url>
        <layout>default</layout>
    </repository>
    <snapshotRepository>
        <id>anypoint-exchange-v3</id>
        <name>Exchange Private Snapshot Repository</name>
        <url>https://maven.anypoint.mulesoft.com/api/v3/organizations/${project.groupId}/maven</url>
        <layout>default</layout>
    </snapshotRepository>
</distributionManagement>
    <build>
        <plugins>
            <plugin>
                <groupId>org.mule.tools.maven</groupId>
                <artifactId>mule-maven-plugin</artifactId>
                <configuration>
                   
                    
                    <!-- CloudHub 2.0 deployment configuration (alternative) -->
                    <cloudhub2Deployment>
                        <uri>https://anypoint.mulesoft.com</uri>
                        <provider>MC</provider>
                        <environment>${cloudhub.environment}</environment>
                        <target>Cloudhub-US-East-1</target>
                        <muleVersion>${cloudhub.runtime.version}</muleVersion>
                        <connectedAppClientId>${connectedApp.clientId}</connectedAppClientId>
						<connectedAppClientSecret>${connectedApp.clientSecret}</connectedAppClientSecret>
						<connectedAppGrantType>client_credentials</connectedAppGrantType>
                        <applicationName>${cloudhub.application.name}</applicationName>
                        <businessGroup>COE</businessGroup>
                        <replicas>${cloudhub.workers}</replicas>
                        <vCores>0.1</vCores>
                        <properties>
                            <mule.env>${cloudhub.environment}</mule.env>
                            <mule.encoding>${app.encoding}</mule.encoding>
                            <anypoint.platform.analytics_enabled>${anypoint.platform.analytics}</anypoint.platform.analytics_enabled>
                            <secure.key>${secure.key}</secure.key>
                            <mcp.server.baseUrl>https://${cloudhub.application.name}.cloudhub.io</mcp.server.baseUrl>
                            <mcp.server.version>1.0.0</mcp.server.version>
                            <mcp.features.enabled>true</mcp.features.enabled>
                            <mcp.proxy.timeout>30000</mcp.proxy.timeout>
                            <http.port>8081</http.port>
                            <https.port>8082</https.port>
                            <http.host>0.0.0.0</http.host>
                        </properties>
                        <deploymentSettings>
                            <http>
                                <inbound>
                                    <lastMileSecurity>true</lastMileSecurity>
                                </inbound>
                            </http>
                        </deploymentSettings>
                    </cloudhub2Deployment>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <dependencies>
        <!-- Mule HTTP Connector -->
        <dependency>
            <groupId>org.mule.connectors</groupId>
            <artifactId>mule-http-connector</artifactId>
        </dependency>

        <!-- Mule Sockets Connector -->
        <dependency>
            <groupId>org.mule.connectors</groupId>
            <artifactId>mule-sockets-connector</artifactId>
        </dependency>

        <!-- APIKit Module -->
        <dependency>
            <groupId>org.mule.modules</groupId>
            <artifactId>mule-apikit-module</artifactId>
            <version>1.10.4</version>
            <classifier>mule-plugin</classifier>
        </dependency>

        <!-- Mule JSON Module -->
        <dependency>
            <groupId>org.mule.modules</groupId>
            <artifactId>mule-json-module</artifactId>
        </dependency>

        <!-- Mule Validation Module -->
        <dependency>
            <groupId>org.mule.modules</groupId>
            <artifactId>mule-validation-module</artifactId>
        </dependency>

        <!-- Mule Secure Configuration Property Module -->
        <dependency>
            <groupId>com.mulesoft.modules</groupId>
            <artifactId>mule-secure-configuration-property-module</artifactId>
        </dependency>

        <!-- Mule Aggregators Module -->
        <dependency>
            <groupId>org.mule.modules</groupId>
            <artifactId>mule-aggregators-module</artifactId>
            <version>1.0.3</version>
            <classifier>mule-plugin</classifier>
        </dependency>

        <!-- Jackson for JSON processing -->
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-core</artifactId>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>

        <!-- Apache Commons Pool -->
        <dependency>
            <groupId>org.apache.commons</groupId>
            <artifactId>commons-pool2</artifactId>
        </dependency>

        <!-- MUnit Testing Framework -->
        <dependency>
            <groupId>com.mulesoft.munit</groupId>
            <artifactId>munit-runner</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.mulesoft.munit</groupId>
            <artifactId>munit-tools</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

</project>
